APP_NAME=OpenDiscovery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120

CACHE_STORE=array
QUEUE_CONNECTION=sync

OCTANE_SERVER=frankenphp

# docker-compose overrides for local stack — see README "Local stack (all services)"
OPENDISCOVERY_RESOLVER=https://resolver.opendiscovery.biz
